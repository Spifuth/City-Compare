# ═══════════════════════════════════════════════════════════════════
#  📐 RÈGLES DE SCORING - RETRAITE DORÉE
# ═══════════════════════════════════════════════════════════════════
#
#  Ces règles favorisent le climat méditerranéen doux.
#  Parfait pour profiter de sa retraite au soleil.
#
# ═══════════════════════════════════════════════════════════════════


# ┌─────────────────────────────────────────────────────────────────┐
# │  ☀️ RÈGLES ENSOLEILLEMENT (très important)                      │
# └─────────────────────────────────────────────────────────────────┘

# Ensoleillement exceptionnel (> 2800h) → bonus maximum
sunshine_hours > 2800 => bonus(25)

# Très bon ensoleillement (> 2500h)
sunshine_hours > 2500 => bonus(18)

# Bon ensoleillement (> 2200h)
sunshine_hours > 2200 => bonus(10)

# Faible ensoleillement → pénalité (moral)
sunshine_hours < 1900 => penalty(15)


# ┌─────────────────────────────────────────────────────────────────┐
# │  🌡️ RÈGLES TEMPÉRATURE (douceur prioritaire)                    │
# └─────────────────────────────────────────────────────────────────┘

# Climat doux parfait pour seniors (15-18°C)
avg_temp >= 15 and avg_temp <= 18 => bonus(20)

# Climat agréable (13-15°C)
avg_temp >= 13 and avg_temp < 15 => bonus(12)

# Trop froid → pénalité (articulations, santé)
avg_temp < 10 => penalty(15)

# Trop chaud → pénalité (canicules dangereuses)
avg_temp > 20 => penalty(10)


# ┌─────────────────────────────────────────────────────────────────┐
# │  🌧️ RÈGLES PRÉCIPITATIONS                                       │
# └─────────────────────────────────────────────────────────────────┘

# Climat sec (< 700mm) → bonus (activités extérieures)
precipitation < 700 => bonus(12)

# Pluvieux → pénalité
precipitation > 900 => penalty(8)

# Très pluvieux → grosse pénalité
precipitation > 1100 => penalty(15)


# ┌─────────────────────────────────────────────────────────────────┐
# │  🌬️ RÈGLES QUALITÉ DE L'AIR                                     │
# └─────────────────────────────────────────────────────────────────┘

# Air pur → important pour la santé des seniors
aqi < 30 => bonus(12)
aqi < 45 => bonus(6)

# Air pollué → risque santé
aqi > 60 => penalty(12)
aqi > 80 => penalty(20)


# ┌─────────────────────────────────────────────────────────────────┐
# │  🎯 COMBOS RETRAITE IDÉALE                                      │
# └─────────────────────────────────────────────────────────────────┘

# Côte d'Azur / Méditerranée
sunshine_hours > 2700 and avg_temp > 15 and precipitation < 800 => bonus(25)

# Sud-Ouest agréable
sunshine_hours > 2200 and avg_temp >= 13 and avg_temp <= 17 => bonus(15)

# Air pur + soleil = santé
aqi < 35 and sunshine_hours > 2400 => bonus(15)


# ┌─────────────────────────────────────────────────────────────────┐
# │  💰 RÈGLES LOYER (secondaire mais considéré)                    │
# └─────────────────────────────────────────────────────────────────┘

# Bonus modéré pour loyers bas
rent_m2 < 12 => bonus(5)

# Pénalité légère pour loyers très élevés
rent_m2 > 20 => penalty(5)
